# --- LLM (Groq, open-source Llama models) ---
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-120b

# --- Pinecone (leave empty to use the in-process local hybrid fallback) ---
PINECONE_API_KEY=
PINECONE_INDEX=crest-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LangSmith (mandatory for the assessment) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crest-assistant

# --- App ---
DEMO_PASSWORD=demo123
HYBRID_ALPHA=0.6
RATE_CAPACITY_VIEWER=5
RATE_CAPACITY_ANALYST=10
RATE_CAPACITY_ADMIN=20
RATE_REFILL_PER_SEC=0.2
TOOL_TIMEOUT_SEC=25
API_URL=http://localhost:8000
